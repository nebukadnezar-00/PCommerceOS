# Gemini anahtarı yalnızca "Derin ara" için gerekir. Boş bırakılırsa FinanceOS/.env'deki anahtar kullanılır.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Aynı arama bu kadar saat içinde tekrar yapılırsa kayıttan açılır (derin arama token harcamaz)
QUICK_CACHE_HOURS=1
DEEP_CACHE_HOURS=6
# API'nin cevap verdiği adresler (DNS rebinding koruması)
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
